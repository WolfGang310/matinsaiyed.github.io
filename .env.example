# Web3Forms access key (used by contact form)
# Get yours at https://web3forms.com — safe for client-side use
VITE_WEB3FORMS_KEY=

# Server-side Web3Forms key (used by /api/contact proxy in Express)
WEB3FORMS_KEY=

# Umami analytics (optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# OAuth portal (optional — only if auth is enabled)
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Google Maps via Frontend Forge proxy (optional)
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
